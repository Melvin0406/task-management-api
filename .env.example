# Copy to .env for local development.
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3308
DB_USER=root
DB_PASSWORD=taskapi
DB_NAME=taskapi

# Where the archived-task notification is POSTed. Required.
# For a live demo, a https://webhook.site/... URL works well.
NOTIFY_URL=https://webhook.site/00000000-0000-0000-0000-000000000000

# Per-attempt HTTP timeout. Without it, "no response" never happens: the
# request just hangs and the retry policy never kicks in.
NOTIFY_TIMEOUT_MS=5000
